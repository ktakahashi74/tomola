{
  "name": "tomola",
  "description": "Multilingual forum software for long-form posts and AI-translated discussion.",
  "repository": "https://github.com/ktakahashi74/tomola",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "push:keys": "tsx scripts/push-keys.ts",
    "figures:backfill": "tsx scripts/figure-backfill.ts",
    "eval:translate": "tsx scripts/eval-translate.ts",
    "build": "pnpm i18n:translate --emit-review-counts && react-router build && vite build --config vite.markdown.config.ts",
    "dev": "react-router dev",
    "start": "node server.ts",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./app/paraglide --emit-ts-declarations --strategy custom-htmlLang baseLocale && react-router typegen && tsc && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:pg": "TOMOLA_TEST_PG=1 vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "notices:generate": "tsx scripts/third-party-notices.ts",
    "notices:check": "tsx scripts/third-party-notices.ts --check",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore-check": "bash scripts/restore-check.sh",
    "check:docs": "node scripts/check.mjs docs",
    "test:fast": "node scripts/check.mjs fast",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:checks": "node --test --test-isolation=none tests/check-runner.test.mjs",
    "check:focused": "node scripts/check.mjs focused",
    "check:integration": "node scripts/check.mjs integration",
    "check:release": "node scripts/check.mjs release",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/create-invite.ts",
    "villages:prepare": "tsx --env-file-if-exists=.env scripts/prepare-villages.ts",
    "langs:open": "tsx --env-file-if-exists=.env scripts/open-lang.ts",
    "translations:requeue": "tsx --env-file-if-exists=.env scripts/requeue-translations.ts",
    "render:rebuild": "tsx --env-file-if-exists=.env scripts/rebuild-render-cache.ts",
    "translations:compare": "tsx --env-file-if-exists=.env scripts/compare-translations.ts",
    "glossary:import": "tsx --env-file-if-exists=.env scripts/import-glossary.ts",
    "site:export": "tsx --env-file-if-exists=.env scripts/export-site.ts",
    "glossary:export": "tsx --env-file-if-exists=.env scripts/export-glossary.ts",
    "embeddings:backfill": "tsx --env-file-if-exists=.env scripts/backfill-embeddings.ts",
    "i18n:translate": "tsx --env-file-if-exists=.env scripts/i18n-translate.ts",
    "media:delete": "tsx --env-file-if-exists=.env scripts/delete-media.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.15",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/passkey": "1.7.15",
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-pgvector": "0.0.15",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@google/genai": "^2.32.0",
    "@milkdown/kit": "7.23.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "isbot": "^5.2.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-cjk-friendly": "2.3.3",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "web-push": "4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-m-function-matcher": "2.4.0",
    "@inlang/plugin-message-format": "4.5.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
