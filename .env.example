# Copy to .env locally. Keep real secrets out of Git and Docker build contexts.
# These defaults are for local development, not a member-facing deployment.

# Authentication: at least 32 random characters in production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Compose: fill on the deployment host, not in this example file.
# Use a hex password so it is safe in the Compose-generated database URL.
POSTGRES_PASSWORD=
SITE_ADDRESS=

# PostgreSQL in production; leave unset for local PGlite.
# DATABASE_URL=postgres://user:password@localhost:5432/tomola
# PostgreSQL pool per process: integer 1..100. Acquisition 10s, queries 30s, idle transactions 60s.
# DATABASE_POOL_MAX=10
PGLITE_DATA_DIR=./.data/pglite
# Only an isolated disposable database with permission to create test databases.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/postgres

# Supported tags: ja,en,fr,de,zh-Hans,zh-Hant,ko,th,vi.
# Production startup checks interface translations for the enabled languages.
ENABLED_LANGS=ja,en
# Optional: fully translated languages awaiting native-speaker review. Must be enabled; ja/en are invalid.
PREVIEW_LANGS=

# Set 1 to allow public reading of posts and lists; empty keeps member-only access.
PUBLIC_READING=
# Set test on the test site to show a notice on pages and mark mail subjects; leave empty in production.
TOMOLA_SITE_STAGE=
# Required for a deployed server: directory containing operator.json and notices.
# Local pnpm dev uses tests/fixtures/operator when this is unset.
# Compose reads this host directory and mounts it read-only at /operator.
TOMOLA_OPERATOR_DIR=
# Village foundations: empty keeps existing behavior; prepare data before enabling.
VILLAGES=
# Set 1 for AI address suggestions on village creation (requires VILLAGES=1); empty or 0 disables them.
VILLAGE_SLUG_SUGGEST=
# Optional model from TRANSLATION_PRIMARY's provider; empty uses its lightweight default.
VILLAGE_SLUG_SUGGEST_MODEL=
# Village chat includes consent, reports/moderation and translation. Requires VILLAGES=1.
# Before opening to external participants, complete legal review of communications handling.
VILLAGE_CHAT=
# Chat uses the primary provider, with separate model, thinking, queue and budget.
# CHAT_TRANSLATION_MODEL=gemini-3.5-flash-lite
# CHAT_TRANSLATION_THINKING=off
# CHAT_TRANSLATION_CONCURRENCY=4
# Chat concurrency must be an integer from 1 to 16.
# CHAT_LLM_MONTHLY_BUDGET_USD=2

# Server and limits. Compose sets PORT=3000 and one trusted Caddy hop.
# PORT=3000
# HOST is unset by default: listen on all addresses. Set 127.0.0.1 for direct local-only use.
# HOST=127.0.0.1
# TRUSTED_PROXY_HOPS=0
# HTTP_SHUTDOWN_TIMEOUT_MS=10000
# MAX_REQUEST_BODY_BYTES=2097152
# WORKER_ENABLED=true
# WORKER_SHUTDOWN_TIMEOUT_MS=8000
# Public-post translation slots per process: integer 1..8; mail runs independently.
# TRANSLATION_CONCURRENCY=2

# External model credentials. Leave empty for local development.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Translation provider: gemini | claude | fake. A missing key defaults to fake.
# Use real engines for a member-facing deployment.
# TRANSLATION_PRIMARY=
# Optional secondary: gemini | claude | fake | none; default none.
# TRANSLATION_SECONDARY=none
# Optional judge: gemini | claude | fake | none; default none.
# DIVERGENCE_JUDGE=none
# Sampling fraction 0..1, only with secondary and judge configured.
# DIVERGENCE_SAMPLE_RATE=0

# Leave model names unset for the defaults in the current source.
# Gemini defaults: primary gemini-3.5-flash-lite; secondary and judge gemini-3.6-flash.
# TRANSLATION_GEMINI_MODEL=
# TRANSLATION_SECONDARY_GEMINI_MODEL=
# TRANSLATION_CLAUDE_MODEL=
# DIVERGENCE_JUDGE_MODEL=
# DIVERGENCE_JUDGE_GEMINI_MODEL=
# Interface-message translation only: Gemini defaults to gemini-3.8-flash, Claude to claude-sonnet-5-5; --model overrides I18N_MODEL.
# I18N_MODEL=
# Gemini thinking: off | low | default.
# GEMINI_TRANSLATION_THINKING=off
# DIVERGENCE_JUDGE_THINKING=off

# Optional automatic mistranslation retry, using the primary provider.
# TRANSLATION_RETRY_MODEL=
# TRANSLATION_RETRY_MEMBER_DAILY_MAX=5
# TRANSLATION_RETRY_DAILY_MAX=30

# Search embeddings: gemini | fake. Missing Gemini key defaults to fake.
# EMBEDDING_ENGINE=
# EMBEDDING_MODEL=

# App accounting limit, USD per UTC calendar month. It is not a provider billing cap.
# LLM_MONTHLY_BUDGET_USD=20
# Unlisted-model price overrides use LLM_PRICE_<NORMALIZED_MODEL_NAME>=input,output.
# Values are USD per million tokens; verify them against current provider prices.

# Only for isolated staging with no member data, never normal production.
# TOMOLA_ALLOW_FAKE_ENGINES=1

# Production requires SMTP_URL and MAIL_FROM. Set credentials only in .env.
# SMTP_URL=
# MAIL_FROM=tomola <no-reply@example.org>
# Required with SMTP_URL: an address the provider accepts without delivering (Postmark: test@blackhole.postmarkapp.com).
# MAIL_DECOY_TO=
# OPERATOR_EMAILS=admin@example.org
# NOTIFICATION_EMAIL_DELAY_SECONDS=300

# HTTPS location of the corresponding source, without user info or credentials.
# SOURCE_URL=

# Presence of this file makes unsafe HTTP methods return 503 and pauses new worker claims.
# MAINTENANCE_FLAG_FILE=/tmp/tomola-maintenance
# Docker build revision (full commit SHA), exposed by /readyz and shortened in the footer.
# TOMOLA_REVISION is used by Compose for the build argument and versioned image tag.
# TOMOLA_REVISION=unknown
# REVISION=unknown
# Isolated home trial only: requires TOMOLA_ALLOW_FAKE_ENGINES=1, fake translation/embedding,
# and no real provider keys. Shows the trial banner. Never enable on a member deployment.
# TOMOLA_HOME_TRIAL=1

# Spam automation and AI report triage default closed. Enable after privacy disclosures.
# AI chat triage additionally requires consent version 2 from each message author.
MODERATION_SPAM_ENABLED=
MODERATION_AI_SPAM_ENABLED=
MODERATION_AI_TRIAGE_ENABLED=
# Uses TRANSLATION_PRIMARY and its credentials. Default Gemini model shown below.
# MODERATION_AI_MODEL=gemini-3.5-flash-lite

# Daily repair of absent public post translations with no jobs. Default off.
# Enabling may spend the translation budget on existing posts.
TRANSLATION_BACKFILL_ENABLED=

# Device notifications stay disabled until representative device testing is complete.
WEB_PUSH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public operator contact, for example mailto:contact@example.org.
VAPID_SUBJECT=

# Village AI destinations are independent and default off. See docs/village-nushi.md.
VILLAGE_NUSHI=
VILLAGE_CHAT_NUSHI=
